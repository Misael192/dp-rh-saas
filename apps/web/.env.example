# Server-only: the browser always calls /api/v1 on the Next.js origin.
API_INTERNAL_URL=http://127.0.0.1:4000
DEPLOYMENT_ENV=development
WEB_ORIGIN=http://localhost:3000
# Production: same 32+ character secret as the API; never NEXT_PUBLIC.
API_PROXY_SECRET=
# Required in production; must be overwritten by an authoritative ingress.
# Vercel: x-vercel-forwarded-for. Docker ingress: x-real-ip (see deploy docs).
TRUSTED_PROXY_HEADER=
