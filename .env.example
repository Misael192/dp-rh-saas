# LOCAL DEVELOPMENT. Generate actual random values with:
# node infra/scripts/init-local-env.mjs
# Production values belong in the deployment provider's secret manager.
NODE_ENV=development
POSTGRES_DB=peopleflow
POSTGRES_USER=peopleflow_migration
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
DATA_ENCRYPTION_KEY=
API_PROXY_SECRET=
DEPLOYMENT_ENV=development
# Production ingress must overwrite this header with the actual client IP.
TRUSTED_PROXY_HEADER=

# Compose hostnames; use 127.0.0.1 and forwarded ports for host development.
# Passwords in connection URLs must be URI encoded.
DATABASE_URL=
DATABASE_ADMIN_URL=
REDIS_URL=
API_INTERNAL_URL=http://api:4000
WEB_ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=4000
REDIS_PREFIX=peopleflow
RATE_LIMIT_MAX=30

# Explicitly opt in to synthetic local seed data. Never enable in production.
SEED_DEMO=false
SEED_PASSWORD=

# Separate integration database; tests must never point at real company data.
TEST_DATABASE_URL=
TEST_DATABASE_ADMIN_URL=
TEST_REDIS_URL=

# Optional Compose backup profile: custom archive + SHA-256, mounted volume.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_PGPASSFILE=
# Create-only production provisioning; no passwords in command arguments/env.
# PROVISION_CONFIRM_DATABASE must equal URL.pathname, e.g. /peopleflow.
PROVISION_TENANT_SLUG=
PROVISION_TENANT_NAME=
PROVISION_COMPANY_SLUG=
PROVISION_COMPANY_NAME=
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_NAME=
PROVISION_PASSWORD_FILE=
PROVISION_CONFIRM_DATABASE=
# No S3/Supabase credentials are needed in Stage 1: storage is Stage 2 scope.
